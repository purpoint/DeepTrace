# Node / frontend (apps/web)
# ---------------------------------------------------------------------------
node_modules/
.vite/
*.local

# ---------------------------------------------------------------------------
# DeepTrace runtime artifacts
# ---------------------------------------------------------------------------
# Local run records before Postgres persistence lands (Phase D)
data/runs/*.jsonl
# Cached page extractions and search results used during development
data/cache/
# Generated evaluation outputs — results are committed deliberately, not by default
data/eval_runs/
*.log

# ---------------------------------------------------------------------------
# Local project documentation
# ---------------------------------------------------------------------------
# Roadmap and per-milestone learning notes are kept on the developer machine
# and deliberately not published. Public documentation required by the
# documentation milestone can be un-ignored individually when it is written.
docs/

# ---------------------------------------------------------------------------
# Editors / OS / tooling
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
.claude/
*.swp
*.swo
