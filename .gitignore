# ---------------------------------------------------------------------------
node_modules/
*.tsbuildinfo
.vite/
*.local

# ---------------------------------------------------------------------------
# DeepTrace runtime artifacts
# ---------------------------------------------------------------------------
# Local run records before Postgres persistence lands (Phase D)
data/runs/*.jsonl
# Cached page extractions and search results used during development
data/cache/
# Generated evaluation outputs — results are committed deliberately, not by default
data/eval_runs/
*.log

# ---------------------------------------------------------------------------
# Local project documentation
# ---------------------------------------------------------------------------
# Roadmap and per-milestone learning notes are kept on the developer machine
# and deliberately not published. Public documentation required by the
# documentation milestone can be un-ignored individually when it is written.
docs/

# ---------------------------------------------------------------------------
# Editors / OS / tooling
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
.claude/
*.swp
*.swo

# ---------------------------------------------------------------------------
# Alembic
# ---------------------------------------------------------------------------
# Migration scripts are tracked; the generated README from `alembic init` is not.
infrastructure/db/migrations/README

# Benchmark output. Regenerable, and the numbers live in EVALUATION.md.
data/evaluation/

# ---------------------------------------------------------------------------
# Deployment secrets and certificates
# ---------------------------------------------------------------------------
# Generated by `make secrets` and `make tls-cert`, mounted into the containers,
# and never committed.
#
# Neither directory is tracked, not even with a .gitkeep. `deploy/secrets/` is
# already excluded by the `secrets/` rule above, and git will not re-include a
# file inside a directory it has excluded -- so a `!deploy/secrets/.gitkeep`
# negation reads as though it keeps the directory and does nothing at all. Both
# targets `mkdir -p` what they need.
deploy/secrets/*
deploy/certs/*
