# DeepTrace configuration template.
#
#   cp .env.example .env
#
# Copy this file to .env and fill in real values. .env is git-ignored and must
# never be committed. This template is the only version tracked, so it holds
# placeholders and documentation, never credentials.
#
# Every variable maps to a field on Settings in core/config.py. Variables for
# subsystems that are not built yet may be left blank -- the application starts
# without them, and the layer that needs a credential reports which one is
# missing when it is first used.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# local | test | staging | production
APP_ENV=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Human-readable console output locally; JSON for log aggregation when deployed.
JSON_LOGS=false

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Default provider. Individual agents may override it, which is what allows a
# single research run to route different stages to different vendors.
LLM_PROVIDER=google

# Only the provider you actually use needs a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model routing. Cheap models handle classification, search-query generation,
# and evidence extraction. Strong models handle analysis, fact checking, and
# final synthesis. Set these from your provider's current model list -- they are
# configuration precisely so routing can be retuned without touching code.
LLM_MODEL_CHEAP=gemini-3.5-flash-lite
LLM_MODEL_STRONG=gemini-3.7-flash
LLM_MODEL_EMBED=gemini-embedding-001

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Sustained request rate the client shapes traffic to, so calls queue instead of
# being rejected. Set this to your provider's published limit. A free tier is
# typically far below what a research run would otherwise issue: one measured run
# over 43 sources produced 64 rate-limit errors without this. 0 disables it.
LLM_REQUESTS_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------
# Tavily returns extracted page content rather than links alone.
# Free tier available at https://tavily.com
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
# Required from the persistence milestone onward.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/deeptrace
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Research limits
# ---------------------------------------------------------------------------
# quick | standard | deep -- see DEPTH_BUDGETS in core/config.py for the
# ceilings each depth enforces on tasks, sources, verification loops, and tokens.
DEFAULT_DEPTH=standard

# Bounded parallelism protects search quotas, LLM spend, and the database.
MAX_CONCURRENT_TASKS=5

# Absolute ceiling on workflow steps. This is what makes an unbounded agent
# loop structurally impossible rather than merely unlikely.
MAX_GRAPH_ITERATIONS=60

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deeptrace

# Where trace spans go: none, console, or otlp.
#
# "none" is the default and leaves OpenTelemetry on its no-op implementation --
# starting a span becomes a function call that does nothing, so an untraced run
# costs nothing and no collector has to be running for the app to start.
#
# "console" prints spans as JSON, which is enough to check instrumentation.
# "otlp" needs OTEL_ENDPOINT pointing at a collector (Jaeger, Tempo, Honeycomb).
OTEL_EXPORTER=none
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=deeptrace

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Required. Every token the API issues is signed with this, so a deployment
# without one cannot sign anyone in -- and a deployment that shares one with
# another environment accepts that environment's tokens. At least 32 characters;
# HS256 keys shorter than that are brute-forceable offline, where there is no
# server to rate limit the attempt. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long an access token lasts. It is verified by signature alone and cannot
# be revoked, so this number is exactly how long a stolen one keeps working.
ACCESS_TOKEN_TTL_SECONDS=900

# How long a session survives without re-entering a password. Long is safe here
# because refresh tokens are recorded server side and can be revoked.
REFRESH_TOKEN_TTL_SECONDS=1209600

# Minimum password length. The only strength rule -- composition requirements
# push people toward "Password1!" and do not help.
PASSWORD_MIN_LENGTH=12

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
# Sign-in attempts per client address, and research submissions per account.
# They are counted differently because they protect different things: one from
# password guessing, the other from spending money.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900
SUBMIT_RATE_LIMIT=20
SUBMIT_RATE_WINDOW_SECONDS=3600
