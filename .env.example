# DeepTrace configuration template.
#
#   cp .env.example .env
#
# Copy this file to .env and fill in real values. .env is git-ignored and must
# never be committed. This template is the only version tracked, so it holds
# placeholders and documentation, never credentials.
#
# Every variable maps to a field on Settings in core/config.py. Variables for
# subsystems that are not built yet may be left blank -- the application starts
# without them, and the layer that needs a credential reports which one is
# missing when it is first used.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# local | test | staging | production
APP_ENV=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Human-readable console output locally; JSON for log aggregation when deployed.
JSON_LOGS=false

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Default provider. Individual agents may override it, which is what allows a
# single research run to route different stages to different vendors.
LLM_PROVIDER=openai

# Only the provider you actually use needs a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model routing. Cheap models handle classification, search-query generation,
# and evidence extraction. Strong models handle analysis, fact checking, and
# final synthesis. Set these from your provider's current model list -- they are
# configuration precisely so routing can be retuned without touching code.
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o
LLM_MODEL_EMBED=text-embedding-3-small

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------
# Tavily returns extracted page content rather than links alone.
# Free tier available at https://tavily.com
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
# Required from the persistence milestone onward.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/deeptrace
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Research limits
# ---------------------------------------------------------------------------
# quick | standard | deep -- see DEPTH_BUDGETS in core/config.py for the
# ceilings each depth enforces on tasks, sources, verification loops, and tokens.
DEFAULT_DEPTH=standard

# Bounded parallelism protects search quotas, LLM spend, and the database.
MAX_CONCURRENT_TASKS=5

# Absolute ceiling on workflow steps. This is what makes an unbounded agent
# loop structurally impossible rather than merely unlikely.
MAX_GRAPH_ITERATIONS=25

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deeptrace

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Required once authentication exists. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
